{
  "info": {
    "_postman_id": "b7f2f5e4-8f0a-4c1e-9d6b-3a1c2e4f5a67",
    "name": "API REST - Catalogo de Productos",
    "description": "Coleccion de pruebas del CRUD de productos. Ejecuta primero el login para guardar el token en la variable {{token}}; el id del producto creado se guarda en {{productoId}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "productoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Autenticacion",
      "item": [
        {
          "name": "Login (guarda el token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve un token JWT', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.token).to.be.a('string');",
                  "  pm.expect(body.data.tokenType).to.eql('Bearer');",
                  "  pm.collectionVariables.set('token', body.data.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@tienda.com\",\n  \"password\": \"Admin123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Valida credenciales y devuelve el JWT. Guarda el token en la variable de coleccion."
          }
        },
        {
          "name": "Login con contrasena incorrecta (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Mensaje de error', () => pm.expect(pm.response.json().error.message).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@tienda.com\",\n  \"password\": \"incorrecta123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Perfil con token (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve el usuario autenticado', () => pm.expect(pm.response.json().data.email).to.eql('admin@tienda.com'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "02 - Endpoints publicos",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Servicio activo', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Listar productos (guarda productoId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve arreglo de productos', () => {",
                  "  pm.expect(body.data).to.be.an('array');",
                  "  pm.expect(body.meta.total).to.be.a('number');",
                  "});",
                  "if (body.data.length > 0) {",
                  "  pm.collectionVariables.set('productoId', body.data[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/productos"
          }
        },
        {
          "name": "Listar con filtros y paginacion",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Respeta el limite', () => pm.expect(body.data.length).to.be.at.most(5));",
                  "pm.test('Metadatos de paginacion', () => pm.expect(body.meta.limit).to.eql(5));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/productos?page=1&limit=5&sort=precio&order=asc"
          }
        },
        {
          "name": "Detalle de producto (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve el producto solicitado', () => pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('productoId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/productos/{{productoId}}"
          }
        },
        {
          "name": "Detalle inexistente (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/productos/00000000-0000-4000-8000-000000000000"
          }
        },
        {
          "name": "Id invalido (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/productos/123"
          }
        }
      ]
    },
    {
      "name": "03 - Endpoints protegidos (JWT)",
      "item": [
        {
          "name": "Crear producto (201, guarda productoId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve el producto creado', () => {",
                  "  pm.expect(body.data.id).to.be.a('string');",
                  "  pm.expect(body.data.activo).to.eql(true);",
                  "});",
                  "pm.test('Cabecera Location', () => pm.expect(pm.response.headers.get('Location')).to.include('/api/productos/'));",
                  "pm.collectionVariables.set('productoId', body.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Camara web Full HD\",\n  \"descripcion\": \"Camara web 1080p con microfono integrado\",\n  \"precio\": 149900,\n  \"stock\": 15,\n  \"categoria\": \"Perifericos\",\n  \"activo\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/productos"
          }
        },
        {
          "name": "Crear sin token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Producto sin token\",\n  \"precio\": 1000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/productos"
          }
        },
        {
          "name": "Crear con datos invalidos (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Detalle por campo', () => pm.expect(pm.response.json().error.details).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"ab\",\n  \"precio\": -10,\n  \"stock\": -5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/productos"
          }
        },
        {
          "name": "Actualizar producto (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Aplica los cambios', () => {",
                  "  pm.expect(body.data.precio).to.eql(279900);",
                  "  pm.expect(body.data.activo).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 279900,\n  \"stock\": 20,\n  \"activo\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/productos/{{productoId}}"
          }
        },
        {
          "name": "Actualizar inexistente (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 1000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/productos/00000000-0000-4000-8000-000000000000"
          }
        },
        {
          "name": "Eliminar producto (204)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));",
                  "pm.test('Sin cuerpo', () => pm.expect(pm.response.text()).to.eql(''));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/productos/{{productoId}}"
          }
        },
        {
          "name": "Eliminar producto ya borrado (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/productos/{{productoId}}"
          }
        }
      ]
    },
    {
      "name": "04 - CORS",
      "item": [
        {
          "name": "Preflight OPTIONS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));",
                  "pm.test('Permite POST', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Methods')).to.include('POST'));"
                ]
              }
            }
          ],
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:5173"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "authorization,content-type"
              }
            ],
            "url": "{{baseUrl}}/productos"
          }
        }
      ]
    }
  ]
}
