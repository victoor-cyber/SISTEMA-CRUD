# Servidor
PORT=3000
NODE_ENV=development

# Seguridad / JWT
JWT_SECRET=super-secreto-cambiar-en-produccion
JWT_EXPIRES_IN=2h

# CORS: usa * para permitir todos, o una lista separada por comas
CORS_ORIGIN=*

# Base de datos (archivo JSON)
DB_FILE=data/db.json

# Usuario administrador creado automaticamente la primera vez
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@tienda.com
ADMIN_PASSWORD=Admin123!
